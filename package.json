{
  "name": "sprintdeck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n WEB,API -c cyan,magenta \"vite\" \"npm --prefix api start -- --port 7072\"",
    "dev:lan": "concurrently -k -n WEB,API -c cyan,magenta \"vite --host\" \"npm --prefix api start -- --port 7072\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@azure/web-pubsub-client": "^1.1.0",
    "@react-oauth/google": "^0.13.5",
    "@rolldown/binding-linux-x64-gnu": "^1.2.5",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
