# Copy to .env.local for local development (Vite reads VITE_* at dev/build time).
# cp .env.example .env.local

# Microsoft Entra / MSAL (Application client ID from App registrations → Overview)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common

# Google Sign-In (OAuth 2.0 Web client ID)
VITE_GOOGLE_CLIENT_ID=

# Optional — UPI QR on subscription modal
VITE_UPI_ID=
